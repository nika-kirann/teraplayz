# Copy to .env for local use (never commit .env). On Render, set these in the dashboard.

# --- Telegram (from https://my.telegram.org → API development tools) ---
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef
# --- Bot token from @BotFather (the bot must be an ADMIN of the private channel) ---
TG_BOT_TOKEN=1234567890:AAExampleExampleExampleExampleExample
# --- Private channel id (starts with -100) ---
TG_CHANNEL_ID=-1001234567890

# --- Admin panel (/admin) ---
ADMIN_PASSWORD=choose-a-long-password
# Long random string used to sign the admin session cookie (Render generates one for you)
SESSION_SECRET=replace-with-a-long-random-string

# --- Local development only: keep files on disk instead of Telegram ---
# STORAGE=local
# LOCAL_DATA_DIR=./data
